{
  "name": "telegram-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pulse: a Telegram group plugin that records the last 24h of a group, digests it into topics, pain points, ideas, opportunities and open questions, and recursively improves its own digest playbook under verified selection.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --no-experimental-webstorage --env-file-if-exists=.env src/main.ts",
    "restart": "node --env-file-if-exists=.env scripts/restart.ts",
    "login": "node --no-experimental-webstorage --env-file-if-exists=.env scripts/login.ts",
    "replay": "node --env-file-if-exists=.env scripts/replay.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "probe": "node --no-experimental-webstorage --env-file-if-exists=.env scripts/probe.ts",
    "autostart": "node scripts/autostart.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "qrcode": "^1.5.4",
    "telegram": "^2.26.22",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "typescript": "^7.0.2"
  }
}
