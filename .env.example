# Both optional when Claude Desktop writes the digests (see COOKBOOK.md, 6A): without a bot token,
# digests stay in the local console; without an API key, the service only collects messages.
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=

# Local console: http://127.0.0.1:4830 (this computer only). 0 turns it off.
PULSE_CONSOLE_PORT=4830

# Recommended (required for watching other people's groups): your Telegram user id.
# Send the bot /start in a private chat to see it. Owners can add the bot to groups and use /watch.
PULSE_OWNER_IDS=

# Reader account: only for groups you do NOT run (see COOKBOOK.md, step 4).
# api_id / api_hash from https://my.telegram.org → API development tools; then run `npm run login`.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
PULSE_READER_SESSION=./data/reader.session
PULSE_READER_POLL_SECONDS=120
# Optional: groups to watch at startup (@username, t.me link, or -100… id of a joined group), comma-separated,
# reported to PULSE_REPORT_TO (default: the first owner's DM with the bot). /watch in Telegram does the same.
PULSE_WATCH=
PULSE_REPORT_TO=

# Defaults for a newly joined group (each group can change them with /settings)
PULSE_TIMEZONE=Asia/Shanghai
PULSE_DIGEST_HOUR=9
# auto | en | zh
PULSE_LANGUAGE=auto
# auto (adopt what wins) | propose (admins approve) | off
PULSE_RSI_MODE=auto

# Model
PULSE_MODEL=claude-opus-5-5
PULSE_DIGEST_EFFORT=high
PULSE_RSI_EFFORT=high

# Self-improvement
PULSE_RSI_CANDIDATES=2
PULSE_RSI_EVAL_WINDOWS=2
PULSE_RSI_EVERY_HOURS=20
PULSE_RSI_MIN_MESSAGES=30
PULSE_RSI_PROMOTE_AT=0.625

# Storage
PULSE_DB=./data/pulse.db
PULSE_RETENTION_DAYS=7
